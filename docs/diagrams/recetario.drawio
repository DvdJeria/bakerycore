<mxfile host="app.diagrams.net">
  <diagram name="Materia Prima y Recetas Avanzado" id="recipe-pro">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Bloque Insumos -->
        <mxCell id="box_ins" value="Módulo de Materia Prima" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="280" height="360" as="geometry" />
        </mxCell>
        <mxCell id="i_crud" value="&lt;b&gt;Gestión CRUD Insumos&lt;/b&gt;&lt;br&gt;Nombre, Unidad de Medida, Costo Unitario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;shadow=1;" vertex="1" parent="box_ins">
          <mxGeometry x="30" y="60" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="i_soft" value="&lt;b&gt;Borrado Lógico (Soft Delete)&lt;/b&gt;&lt;br&gt;Inactiva el insumo sin perder trazabilidad histórica" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;shadow=1;" vertex="1" parent="box_ins">
          <mxGeometry x="30" y="200" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Bloque Recetario -->
        <mxCell id="box_rec" value="Módulo de Recetario Digital" style="swimlane;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="300" height="360" as="geometry" />
        </mxCell>
        <mxCell id="r_create" value="&lt;b&gt;Asociación de Ingredientes&lt;/b&gt;&lt;br&gt;Vincula insumos activos a la receta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;shadow=1;" vertex="1" parent="box_rec">
          <mxGeometry x="40" y="60" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r_steps" value="&lt;b&gt;Instrucciones &amp; Multimedia&lt;/b&gt;&lt;br&gt;Pasos de preparación + Registro de Fotografía del Producto Final" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;shadow=1;" vertex="1" parent="box_rec">
          <mxGeometry x="40" y="200" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- Conexiones -->
        <mxCell id="conn1" value="Estado Inactivo" style="endArrow=classic;html=1;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;dashed=1;" edge="1" parent="box_ins" source="i_crud" target="i_soft">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn2" value="Uso en Recetas" style="endArrow=classic;html=1;rounded=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=2;" edge="1" parent="1" source="i_crud" target="r_create">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="conn3" value="Secuencia" style="endArrow=classic;html=1;rounded=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeWidth=2;" edge="1" parent="box_rec" source="r_create" target="r_steps">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>